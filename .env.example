# PRANVYRA Environment Variables
# Copy this file to .env and insert your real keys

# Google Gemini API key (optional: PRANVYRA includes a resilient heuristic engine if omitted)
GEMINI_API_KEY=your_gemini_api_key_here

# Flask Secret Key
SECRET_KEY=your_flask_secret_key_here

# Flask Run Settings
FLASK_ENV=development
PORT=5000

